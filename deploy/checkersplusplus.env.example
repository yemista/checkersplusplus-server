# Checkers++ server environment.
#
# Copy to /etc/checkersplusplus/env on each node, fill in the real values, then:
#     chown root:cpp /etc/checkersplusplus/env
#     chmod 640      /etc/checkersplusplus/env
#
# Do not commit the filled-in copy.

# ---------------------------------------------------------------- required

# No default. The app will not start without it.
CPP_DB_PASSWORD=

# Mail relay credentials. Needed on BOTH API servers, not just the "server" profile
# node: AccountController calls EmailService inline on account creation, verification
# resend, and username recovery, so whichever node the load balancer picks does the
# sending. ws-1 needs them too for the admin alert queue.
CPP_MAIL_HOST=
CPP_MAIL_USERNAME=
CPP_MAIL_PASSWORD=

# ---------------------------------------------------------------- connection

# Point at the VLAN address of the database, never a public one.
CPP_DB_URL=jdbc:postgresql://10.0.0.40:5432/checkersplusplus
CPP_DB_USERNAME=checkersplusplus

# 587 with STARTTLS is the default. For implicit TLS on 465, set CPP_MAIL_PORT=465,
# CPP_MAIL_SSL=true and CPP_MAIL_STARTTLS=false.
CPP_MAIL_PORT=587
CPP_MAIL_AUTH=true
CPP_MAIL_STARTTLS=true
CPP_MAIL_SSL=false

# Envelope sender. Must be verified with your provider or the relay rejects the message.
CPP_MAIL_FROM=admin@checkersplusplus.com

# Logs the entire SMTP conversation, credentials included. Never true in production.
CPP_MAIL_DEBUG=false

# ---------------------------------------------------------------- behaviour

# validate refuses to start on a schema mismatch rather than altering a live database.
# Use update only when you intend Hibernate to change the schema.
CPP_DDL_AUTO=validate

CPP_SERVER_PORT=8080
CPP_DB_POOL_MIN=10
CPP_DB_POOL_MAX=20

CPP_TIMEOUT_MINUTES=15
CPP_MOVE_TIMEOUT_MINUTES=3
CPP_DISCONNECT_TIMEOUT_SECONDS=30

CPP_LOG_LEVEL=INFO
CPP_LOG_FILE=/var/log/checkersplusplus/checkersplusplus.log

# ---------------------------------------------------------------- profiles
#
# Set SPRING_PROFILES_ACTIVE per node in the systemd unit, not here. Three of the
# background jobs are singletons and must run on exactly one node each:
#
#   api-1   (none)              REST only
#   api-2   (none)              REST only
#   ws-1    websocket,timeout   sockets + the move/disconnect timeout sweeper
#   ws-2    websocket,bot       sockets + bot game creation and bot moves
#
# The "server" profile owns the outgoing mail queue. Put it on whichever node has SMTP
# egress -- ws-1 or ws-2 if the API tier sits behind NAT.
